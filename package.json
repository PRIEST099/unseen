{
  "name": "the-unseen",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint packages/core/src/classifier",
    "shop": "npm run start -w cursed-shop",
    "unseen:install-global": "node scripts/install-global.mjs"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "typescript-eslint": "^8.74.0"
  }
}
