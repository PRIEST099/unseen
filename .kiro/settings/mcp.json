{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.86",
        "--browser",
        "chromium"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": [
        "browser_navigate",
        "browser_snapshot",
        "browser_take_screenshot",
        "browser_console_messages",
        "browser_resize",
        "browser_press_key",
        "browser_wait_for"
      ]
    },
    "unseen": {
      "command": "node",
      "args": [
        "packages/mcp/dist/server.js"
      ],
      "env": {
        "UNSEEN_CHROMIUM_CHANNEL": "chromium"
      },
      "disabled": false,
      "autoApprove": [
        "audit_url",
        "audit_html",
        "explain_haunting",
        "suggest_fix"
      ]
    }
  }
}
