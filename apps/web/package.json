{
  "name": "@the-unseen/web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "cross-env NODE_ENV=development tsx watch src/server/main.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "cross-env NODE_ENV=production node dist/server/main.js",
    "start:test": "cross-env NODE_ENV=test UNSEEN_DEV_ALLOW_PRIVATE=1 node dist/server/main.js",
    "test": "vitest --run",
    "test:int": "vitest --run --config vitest.int.config.ts",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.server.json",
    "build-samples": "node scripts/build-samples.mjs"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/static": "^10.0.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@the-unseen/core": "0.1.0",
    "fastify": "^5.0.0",
    "focus-trap-react": "^12.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.1.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "jsdom": "^25.0.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.4"
  }
}
